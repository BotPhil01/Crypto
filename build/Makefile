# GNU Make workspace makefile autogenerated by Premake

ifndef config
  config=debug
endif

ifndef verbose
  SILENT = @
endif

ifeq ($(config),debug)
  Crypto_config = debug

else ifeq ($(config),test)
  Crypto_config = test

else ifeq ($(config),release)
  Crypto_config = release

else
  $(error "invalid configuration $(config)")
endif

PROJECTS := Crypto

.PHONY: all clean help $(PROJECTS) 

all: $(PROJECTS)

Crypto:
ifneq (,$(Crypto_config))
	@echo "==== Building Crypto ($(Crypto_config)) ===="
	@${MAKE} --no-print-directory -C Crypto -f Makefile config=$(Crypto_config)
endif

clean:
	@${MAKE} --no-print-directory -C Crypto -f Makefile clean

help:
	@echo "Usage: make [config=name] [target]"
	@echo ""
	@echo "CONFIGURATIONS:"
	@echo "  debug"
	@echo "  test"
	@echo "  release"
	@echo ""
	@echo "TARGETS:"
	@echo "   all (default)"
	@echo "   clean"
	@echo "   Crypto"
	@echo ""
	@echo "For more information, see https://github.com/premake/premake-core/wiki"